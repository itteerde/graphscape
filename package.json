{
  "name": "graphscape",
  "version": "0.1.0",
  "description": "three.js based graph editor and viewer for websites: 2D/3D, GraphML (yEd) import, fully skinnable",
  "license": "MIT",
  "type": "module",
  "main": "./dist/lib/graphscape.js",
  "module": "./dist/lib/graphscape.js",
  "types": "./dist/types/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/lib/index.d.ts",
      "import": "./dist/lib/graphscape.js"
    }
  },
  "files": ["dist/lib", "dist/standalone", "dist/types", "README.md", "LICENSE"],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:editor": "vite build",
    "build:lib": "vite build -c vite.lib.config.ts",
    "build:standalone": "vite build -c vite.standalone.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run typecheck && npm run test && npm run build:editor && npm run build:lib && npm run build:standalone && npm run build:types",
    "serve": "node scripts/serve.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "peerDependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.18"
  }
}
